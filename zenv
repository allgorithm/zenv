#!/usr/bin/env bash

# zenv — Zero-Config Docker Environment CLI for Laravel 13 & PHP 8.4+

# PATH anpassen, um standardmäßige Docker-Installationspfade auf macOS einzuschließen
export PATH="/Applications/Docker.app/Contents/Resources/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

# Setzen der Benutzer-ID und Gruppen-ID für den Docker-Build
USER_UID=$(id -u)
export USER_UID
USER_GID=$(id -g)
export USER_GID

# Docker Compose Befehl ermitteln (modern vs. legacy)
if docker compose version >/dev/null 2>&1; then
    DOCKER_COMPOSE="docker compose"
else
    DOCKER_COMPOSE="docker-compose"
fi

# TTY-Erkennung für interaktive Terminals vs. CI/CD und Pipes
EXEC_FLAGS=(-i)
if [ -t 0 ] && [ -t 1 ]; then
    EXEC_FLAGS=(-it)
fi

# Hilfe anzeigen
function show_help {
    echo -e "\033[1;36mzenv — Zero-Config Docker Environment CLI\033[0m"
    echo -e "Nutzung: ./zenv [Befehl]"
    echo ""
    echo "Dienste verwalten:"
    echo "  up            Dienste im Hintergrund starten"
    echo "  down          Dienste stoppen und Container entfernen"
    echo "  stop          Dienste anhalten"
    echo "  restart       Dienste neu starten"
    echo "  ps            Status der laufenden Container anzeigen"
    echo "  logs [svc]    Logs anzeigen (optional für Dienst, z.B. app, web, redis)"
    echo ""
    echo "Laravel & Tools im App-Container ausführen:"
    echo "  artisan ...   Ausführen von php artisan"
    echo "  composer ...  Ausführen von composer"
    echo "  npm ...       Ausführen von npm (z.B. ./zenv npm run dev für Vite)"
    echo "  npx ...       Ausführen von npx"
    echo "  php ...       Ausführen eines PHP-Befehls"
    echo "  pest ...      Ausführen von Pest PHP Tests"
    echo "  mariadb       Interaktive MariaDB-Konsole (Host) öffnen"
    echo "  init          Laravel-Projekt initialisieren"
    echo "  shell         Interaktive Shell im PHP-Container öffnen"
    echo ""
    echo "Beliebige andere Argumente werden direkt im 'app'-Container ausgeführt."
}

if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

CMD="$1"
shift

case "$CMD" in
    up)
        $DOCKER_COMPOSE up -d "$@"
        ;;
    down)
        $DOCKER_COMPOSE down "$@"
        ;;
    stop)
        $DOCKER_COMPOSE stop "$@"
        ;;
    restart)
        $DOCKER_COMPOSE restart "$@"
        ;;
    ps)
        $DOCKER_COMPOSE ps "$@"
        ;;
    logs)
        $DOCKER_COMPOSE logs -f "$@"
        ;;
    artisan)
        $DOCKER_COMPOSE exec "${EXEC_FLAGS[@]}" app php artisan "$@"
        ;;
    composer)
        $DOCKER_COMPOSE exec "${EXEC_FLAGS[@]}" app composer "$@"
        ;;
    npm)
        $DOCKER_COMPOSE exec "${EXEC_FLAGS[@]}" app npm "$@"
        ;;
    npx)
        $DOCKER_COMPOSE exec "${EXEC_FLAGS[@]}" app npx "$@"
        ;;
    php)
        $DOCKER_COMPOSE exec "${EXEC_FLAGS[@]}" app php "$@"
        ;;
    pest|test)
        $DOCKER_COMPOSE exec "${EXEC_FLAGS[@]}" app vendor/bin/pest "$@"
        ;;
    mariadb|mysql)
        mariadb -h host.docker.internal -u root laravel "$@"
        ;;
    shell)
        $DOCKER_COMPOSE exec "${EXEC_FLAGS[@]}" app bash "$@"
        ;;
    init|init-laravel)
        $DOCKER_COMPOSE exec "${EXEC_FLAGS[@]}" app bash docker/init.sh
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        $DOCKER_COMPOSE exec "${EXEC_FLAGS[@]}" app "$CMD" "$@"
        ;;
esac
